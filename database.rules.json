{
  "rules": {
    "$restoId": {
      "pedidos_activos": {
        ".read": true,
        ".write": "auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin')",
        "$key": {
          ".write": "(!data.exists() && newData.child('status').val() === 'esperando_confirmacion') || (auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin'))"
        }
      },
      "delivery_pedidos": {
        ".read": "auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin')",
        ".write": "auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin')",
        "$key": {
          ".read": true,
          ".write": "(!data.exists() && newData.child('status').val() === 'esperando_confirmacion') || (auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin'))"
        }
      },
      "mesas_activas": {
        ".read": true,
        ".write": "auth != null && (auth.token.restoId === $restoId || auth.token.role === 'superadmin')"
      }
    }
  }
}
